# Copy to server/.env and fill in. server/.env is git-ignored - never commit real keys.

# ---- Server ----
PORT=4000
NODE_ENV=development
# REQUIRED in production (the server refuses to start without it).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Comma separated extra allowed browser origins (same-origin deployments need none)
CORS_ORIGINS=http://localhost:5173

# ---- Storage ----
DATABASE_PATH=./storage/bookleaf.db
UPLOAD_DIR=./storage/uploads

# ---- AI (server side only - never sent to the browser) ----
# Leave OPENAI_API_KEY empty to run in "manual mode": tickets are classified by the
# rule-based fallback and admins get template drafts instead of LLM drafts.
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_ENABLED=true
# List prices (USD per 1M tokens) for the cost estimate on the admin "AI & usage" page
AI_PRICE_INPUT=0.15
AI_PRICE_OUTPUT=0.60
AI_PRICE_CACHE_READ=0.075

# ---- Seed credentials (demo data) ----
SEED_AUTHOR_PASSWORD=Author@123
SEED_ADMIN_PASSWORD=Admin@123
