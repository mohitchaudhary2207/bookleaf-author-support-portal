# Copy to server/.env and fill in. server/.env is git-ignored - never commit real keys.

# ---- Server ----
PORT=4000
NODE_ENV=development
# REQUIRED in production (the server refuses to start without it).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Comma separated extra allowed browser origins (same-origin deployments need none)
CORS_ORIGINS=http://localhost:5173

# ---- Storage ----
DATABASE_PATH=./storage/bookleaf.db
UPLOAD_DIR=./storage/uploads

# ---- AI (server side only - never sent to the browser) ----
# Leave OPENAI_API_KEY empty to run in "manual mode": tickets are classified by the
# rule-based fallback and admins get template drafts instead of LLM drafts.
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_ENABLED=true
# List prices (USD per 1M tokens) for the cost estimate on the admin "AI & usage" page
AI_PRICE_INPUT=0.15
AI_PRICE_OUTPUT=0.60
AI_PRICE_CACHE_READ=0.075

# ---- Demo data seeding ----
# development / test : the provided dataset (10 authors, 18 books, 5 demo tickets) is seeded into an EMPTY database
#                      automatically. Leave the values below empty to use the documented demo-only passwords
#                      (Author@123 / Admin@123), or set SEED_DEMO_DATA=false to disable seeding.
# production         : seeding is OFF by default. For an isolated EVALUATION deployment set SEED_DEMO_DATA=true AND
#                      provide both passwords (min 8 characters). There are no built-in production passwords; the
#                      server refuses to start with SEED_DEMO_DATA=true if either is missing.
SEED_DEMO_DATA=
SEED_AUTHOR_PASSWORD=
SEED_ADMIN_PASSWORD=

# ---- Frontend build flag (set in the build environment, not read by the server) ----
# VITE_SHOW_DEMO=true  adds the click-to-fill "Demo accounts" panel to the login page and EMBEDS the demo passwords
#                      in the frontend bundle. Default for production builds: off. The vite dev server shows it
#                      unless VITE_SHOW_DEMO=false.
# VITE_SHOW_DEMO=false
