{
  "name": "bookleaf-support-portal",
  "version": "1.0.0",
  "private": true,
  "description": "BookLeaf Author Support & Communication Portal",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "test": "npm test -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
